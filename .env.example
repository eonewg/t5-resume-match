# Relative SQLite paths are resolved from the project root.
T5_DATABASE_URL=sqlite:///data/t5.db
# PostgreSQL (see docs/postgres.md; supply your own password):
# T5_DATABASE_URL=postgresql+psycopg://t5:YOUR_PASSWORD@127.0.0.1:55432/t5
# T5_TEST_DATABASE_URL uses a dedicated test database; tests create isolated schemas.
T5_RESUME_PROVIDER=backend.modules.resume.public:ResumeService
T5_JOBS_PROVIDER=backend.modules.jobs.public:JobsService
T5_DIAGNOSIS_PROVIDER=mock
T5_ANALYTICS_PROVIDER=backend.modules.analytics.public:AnalyticsService
# Real modules: dotted.public.module:ProviderClass (zero-argument constructor)
# Real diagnosis: configure locally, never commit a key. See module README.
# T5_DIAGNOSIS_PROVIDER=backend.modules.diagnosis.public:DiagnosisService
# DEEPSEEK_API_KEY=
# T5_DIAGNOSIS_MODEL=deepseek-v4-flash
# T5_DATABASE_URL=postgresql+psycopg://t5:local-password@localhost:5432/t5

# T5_DIAGNOSIS_LLM_VENDOR=custom
# T5_DIAGNOSIS_API_STYLE=openai_chat
# T5_DIAGNOSIS_BASE_URL=https://your-provider.example/v1
# T5_DIAGNOSIS_MODEL=your-model
# T5_DIAGNOSIS_API_KEY=
# API_STYLE also supports openai_responses / anthropic_messages.
# REASONING_EFFORT is optional; omit unless the selected vendor/model supports it.
# T5_DIAGNOSIS_TIMEOUT_SECONDS=30
# T5_DIAGNOSIS_MAX_ATTEMPTS=3
